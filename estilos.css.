
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

body {
    font-family: Arial, sans-serif;
    background-color: #f1f5f9;
    color: #1e293b;
}

header {
    background: linear-gradient(135deg, #12345a, #087eae);
    color: white;
    text-align: center;
    padding: 55px 20px;
}

header h1 {
    font-size: 38px;
    margin-bottom: 12px;
}

header p {
    font-size: 18px;
}

nav {
    background-color: #10243e;
    padding: 17px;
    text-align: center;
}

nav a {
    color: white;
    text-decoration: none;
    margin: 0 18px;
    font-weight: bold;
}

nav a:hover {
    color: #38bdf8;
}

main {
    max-width: 1000px;
    margin: auto;
    padding: 30px 20px;
}

section {
    background-color: white;
    margin-bottom: 25px;
    padding: 30px;
    border-radius: 12px;
    box-shadow: 0 3px 12px rgba(0,0,0,0.07);
}

section h2 {
    color: #087eae;
    margin-bottom: 18px;
}

section p {
    line-height: 1.8;
}

.principal img {
    width: 100%;
    max-height: 350px;
    object-fit: cover;
    border-radius: 10px;
    margin-top: 20px;
}

.tarjetas {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 20px;
}

.tarjeta {
    background: #eaf5fc;
    padding: 22px;
    border-radius: 10px;
    border-bottom: 4px solid #087eae;
}

.tarjeta h3 {
    color: #087eae;
    margin-bottom: 10px;
}

footer {
    background: #10243e;
    color: white;
    text-align: center;
    padding: 25px;
}

@media (max-width: 650px) {
    header h1 {
        font-size: 28px;
    }

    nav a {
        display: inline-block;
        margin: 8px;
    }

    .tarjetas {
        grid-template-columns: 1fr;
    }
}
